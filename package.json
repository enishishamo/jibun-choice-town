{
  "name": "jibun-choice-town",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:v2": "tsc -b && VITE_INCLUDE_V2=1 vite build",
    "check:ver1-freeze": "node factory/harness/ver1-freeze-check.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "queue:blocked": "node factory/harness/task-state.mjs list --status BLOCKED,DESIGN_BLOCKED,HUMAN_DECISION_REQUIRED --markdown > factory/state/blocked-queue.md",
    "qa:all": "node factory/harness/verify.mjs --suites 'gameplay-qa-*.mjs'",
    "qa:v2-lunch": "node factory/harness/gameplay-qa-v2-lunch-menu.mjs",
    "selftest:factory": "node factory/harness/factory-self-test.mjs",
    "shots:v2-lunch": "node factory/harness/v2-lunch-shots.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "puppeteer-core": "^25.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
